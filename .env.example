GOOGLE_MAPS_API_KEY=
# Separate browser-restricted key for the optional map UI.
GOOGLE_MAPS_BROWSER_API_KEY=
PORT=3000
# Optional: no token uses VTA direct GTFS, scheduled-only. Never paste a real token into this file.
TRANSIT_511_API_KEY=
TRANSIT_511_HOURLY_BUDGET=54
GTFS_RT_TRIP_INTERVAL_SECONDS=120
GTFS_RT_ALERT_INTERVAL_SECONDS=300
GTFS_RT_TRIP_MAX_AGE_SECONDS=300
GTFS_RT_ALERT_MAX_AGE_SECONDS=900
GTFS_STATIC_REFRESH_SECONDS=86400
GTFS_SEARCH_HOURS=6
GTFS_MAX_TRANSFERS=2
# Google matrix elements, not HTTP requests. Results warn if truncated.
BIKE_MATRIX_ELEMENT_BUDGET=3000
